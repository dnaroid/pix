{
  "name": "pix-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm --prefix ../acp run build",
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "prebuild": "npm --prefix ../acp run build",
    "build": "tauri build",
    "build:web": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@lucide/svelte": "^1.40.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "sugar-high": "2.2.2",
    "svelte": "5.57.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@tsconfig/svelte": "5.0.6",
    "@types/node": "24.12.4",
    "svelte-check": "4.4.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.19.0 <25"
  }
