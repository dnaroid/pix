{
  "name": "pix-desktop",
  "version": "2.0.10",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm --prefix .. run build:pix && npm --prefix ../acp run build",
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "prebuild": "npm --prefix .. run build:pix && npm --prefix ../acp run build",
    "build": "tauri build",
    "build:web": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:git-workflow": "node scripts/git-workflow-smoke.mjs",
    "test:context-menu": "node scripts/context-menu-smoke.mjs",
    "test:transcript-activity": "node scripts/transcript-activity-smoke.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@lucide/svelte": "^1.47.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "2.3.3",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-notification": "2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "jsonc-parser": "3.3.1",
    "mermaid": "^11.17.2",
    "sugar-high": "2.4.1",
    "svelte": "5.57.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.6.2",
    "svelte-check": "4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.19.0 <27"
  }
}
