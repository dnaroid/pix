{
	"name": "pix-acp",
	"version": "2.0.6",
	"private": true,
	"type": "module",
	"description": "ACP (Agent Client Protocol) adapter that embeds the pix/pi coding agent into editors like Zed. Fork-in-progress of pi-acp with pix-specific integrations.",
	"keywords": [
		"agent-client-protocol",
		"acp",
		"pi",
		"zed",
		"coding-agent"
	],
	"license": "MIT",
	"bin": {
		"pix-acp": "./dist/main.js"
	},
	"engines": {
		"node": ">=22.19.0 <27"
	},
	"scripts": {
		"dev": "tsx src/main.ts",
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "node --import tsx --test \"test/**/*.test.ts\"",
		"test:stdio": "npm run build --silent && node test/stdio-smoke.mjs",
		"check": "npm run typecheck && npm test && npm run test:stdio"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "1.4.0",
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@earendil-works/pi-server": "0.85.1",
		"@mariozechner/clipboard": "0.3.9",
		"jsonc-parser": "3.3.1",
		"proper-lockfile": "4.1.2"
	},
	"devDependencies": {
		"@types/node": "26.6.2",
		"@types/proper-lockfile": "4.1.4",
		"tsx": "4.23.13",
		"typescript": "6.0.3"
	}
}
