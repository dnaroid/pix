{
  "name": "pi-ui-extend",
  "version": "2.0.22",
  "private": true,
  "description": "Pix: a workspace-first terminal UI for Pi with tabs, readable tool activity, voice input, and bundled agent tools.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnaroid/pix.git"
  },
  "homepage": "https://github.com/dnaroid/pix#readme",
  "bugs": {
    "url": "https://github.com/dnaroid/pix/issues"
  },
  "type": "module",
  "bin": {
    "pi-ui-extend": "bin/pix.mjs",
    "pix": "bin/pix.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./schemas/pix.json": "./schemas/pix.json",
    "./schemas/pix-desktop.json": "./schemas/pix-desktop.json",
    "./schemas/pi-tools-suite.json": "./schemas/pi-tools-suite.json",
    "./schemas/tasks.json": "./schemas/tasks.json",
    "./schemas/workspace.json": "./schemas/workspace.json",
    "./schemas/registry.json": "./schemas/registry.json"
  },
  "files": [
    "bin",
    "wiki",
    "dist",
    "scripts/pix-memory-profiler.mjs",
    "scripts/profile-pix-memory.mjs",
    "schemas",
    "skills",
    "!skills/**/.pi",
    "external/pi-tools-suite/index.ts",
    "external/pi-tools-suite/runtime-loader.mjs",
    "external/pi-tools-suite/build/runtime",
    "external/pi-tools-suite/package.json",
    "external/pi-tools-suite/README.md",
    "external/pi-tools-suite/src",
    "external/pi-tools-suite/docs",
    "external/pi-tools-suite/licenses",
    "README.md",
    "!**/__pycache__",
    "!**/*.pyc"
  ],
  "scripts": {
    "check:wiki": "node --import tsx scripts/check-wiki.ts",
    "search:index": "node --import tsx scripts/search-index.ts",
    "predev": "npm run link:pix --silent",
    "dev": "tsx src/main.ts",
    "start": "tsx src/main.ts",
    "prebuild:pix": "npm run generate-schemas --silent",
    "build:pix": "tsc -p tsconfig.json",
    "build:tools-suite": "node scripts/build-pi-tools-suite.mjs",
    "prelink:pix": "npm run build:pix --silent",
    "link:pix": "npm link --silent",
    "watch:pix": "npm run link:pix --silent && node scripts/watch-pix.mjs",
    "watch:all": "node scripts/watch-all.mjs",
    "qa:desktop": "node scripts/qa-desktop.mjs",
    "qa:sandbox": "node scripts/qa-sandbox.mjs",
    "rebuild:all": "npm run build:desktop",
    "check": "npm run check:inner",
    "check:ci": "node scripts/check-ci.mjs",
    "check:ci:preflight": "node scripts/ci-preflight.mjs",
    "ci:history": "node scripts/ci-history-report.mjs",
    "precheck:inner": "npm run generate-schemas --silent && node scripts/ci-test-contracts.mjs --check",
    "check:inner": "npm run sync:sdk-pin:check --silent && npm run release:version:check --silent && tsc --noEmit && npm run test:inner && npm run test:release",
    "test": "npm run test:inner",
    "test:inner": "node --import tsx --test \"tests/**/*.test.ts\"",
    "eval:heads-up": "node --import tsx scripts/heads-up-eval/run.ts",
    "eval:knowledge": "node --import tsx scripts/knowledge-check-eval/run.ts",
    "test:knowledge-eval": "tsc -p scripts/knowledge-check-eval/tsconfig.json && node --import tsx --test tests/knowledge-check-eval*.test.ts tests/knowledge-check-retrieval.test.ts",
    "eval:session-revisions": "node --import tsx scripts/session-revision-eval/run.mjs",
    "test:session-revisions": "node --test scripts/session-revision-eval/test.mjs",
    "test:heads-up-eval": "tsc -p scripts/heads-up-eval/tsconfig.json && node --import tsx --test tests/heads-up-*.test.ts",
    "test:tools-suite": "npm --prefix external/pi-tools-suite test",
    "test:dcp-session-sim": "npm --prefix external/pi-tools-suite run test:dcp-session-sim",
    "test:dcp-reminder-e2e": "npm --prefix external/pi-tools-suite run test:dcp-reminder-e2e",
    "build:acp": "npm --prefix acp run build",
    "check:acp": "npm --prefix acp run check",
    "dev:desktop": "npm --prefix desktop run dev",
    "build:desktop": "npm --prefix desktop run build",
    "check:desktop": "npm --prefix desktop run check",
    "test:browser-qa-e2e": "npm --prefix external/pi-tools-suite run test:browser-qa-e2e",
    "sync:pi-tools-suite": "node scripts/sync-pi-tools-suite.mjs",
    "sync:pi-tools-suite:check": "node scripts/sync-pi-tools-suite.mjs --check",
    "migrate:claude-provider": "node scripts/migrate-claude-provider.mjs",
    "sync:sdk-pin": "node scripts/sync-sdk-pin.mjs",
    "sync:sdk-pin:check": "node scripts/sync-sdk-pin.mjs --check",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=src/**/*.ts --test-coverage-exclude=src/main.ts --test-coverage-lines=94 --test-coverage-branches=80 --test-coverage-functions=94 \"tests/**/*.test.ts\"",
    "update-sdk-references": "node .pi/skills/pi-sdk/scripts/update-references.mjs",
    "prepack": "npm run generate-schemas --silent && npm run build:tools-suite --silent",
    "release:version": "node scripts/release/sync-version.mjs",
    "release:version:check": "node scripts/release/sync-version.mjs --check",
    "version": "node scripts/release/sync-version.mjs --stage",
    "release:prepare": "node scripts/release/prepare.mjs",
    "release:build": "node scripts/release/bundle.mjs",
    "release:build:desktop": "node scripts/release/build-desktop.mjs",
    "release:smoke": "node scripts/release/smoke.mjs",
    "release:smoke:desktop": "node scripts/release/smoke-desktop.mjs",
    "test:release": "node --test scripts/release/test/*.test.mjs",
    "generate-schemas": "tsx scripts/generate-schemas.ts",
    "generate-schemas:check": "tsx scripts/generate-schemas.ts --check",
    "generate-schemas:watch": "tsx watch scripts/generate-schemas.ts"
  },
  "dependencies": {
    "@cortexkit/antigravity-auth-core": "2.2.1",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@lydell/node-pty": "1.1.0",
    "@mariozechner/clipboard": "^0.3.9",
    "@xterm/headless": "^6.0.0",
    "grok-mermaid": "0.2.3",
    "ignore": "7.0.8",
    "jsonc-parser": "3.3.1",
    "katex": "0.16.47",
    "tar": "^7.5.22",
    "typebox": "1.3.34",
    "vscode-jsonrpc": "^9.0.2",
    "vscode-languageserver-protocol": "^3.18.3",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.42.2",
    "@types/node": "26.6.2",
    "@types/yauzl": "^3.4.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "sugar-high": "2.4.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.19.0 <27"
  },
  "keywords": [
    "pi",
    "pix",
    "coding-agent",
    "terminal",
    "renderer"
  ]
}
