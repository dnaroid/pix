{
  // Value of asyncSubagents in pi-tools-suite.jsonc.
  // Bundled role definitions and ordered models live in agents/*.md.
  // Full config schema: https://unpkg.com/pi-ui-extend/schemas/pi-tools-suite.json
  "defaultType": "research",
  "maxConcurrent": 5,
  "maxResultBytes": 100000,
  "vision": {
    "blindModelPatterns": [
      "zai/glm-4.5*", "glm-4.5*", "*/glm-4.5*",
      "zai/glm-5-turbo*", "glm-5-turbo*", "*/glm-5-turbo*",
      "zai/glm-5.3", "glm-5.3", "*/glm-5.3"
    ]
  },
  // Only omitted roles use the LLM router. Model selection itself is deterministic.
  "routing": {
    "enabled": true,
    "model": "zai/glm-5-turbo",
    "fallbackModels": ["openai-codex/gpt-5.6-luna"],
    "maxTaskChars": 1200,
    "maxTokens": 512,
    "maxRetries": 1,
    "timeoutMs": 12000,
    "debug": false
  },
  // A preset is an available model pool, NOT a role-to-model mapping.
  // Choose the first usable entry in each agent's models that is in
  // this pool. Pool order does not reorder agent preferences. The remaining
  // matching candidates are the only quota fallbacks; never leave the pool.
  // Oracle uses its strong candidate list, preferring another provider when
  // possible, but also respects this pool. An empty intersection is an error.
  // Explicit task.model, CLI --model, and FORCE_CURRENT_MODEL remain overrides.
  // Legacy preset model/types/fallbackModels fields still load for compatibility.
  "presets": {
    "cheap": {
      "description": "GLM pool: economical workers plus GLM-5.3 for oracle.",
      "models": ["zai/glm-5-turbo", "zai/glm-5.3-flash", "zai/glm-5.3"]
    },
    "gpt": {
      "description": "GPT pool: Luna/Terra workers; Sol is available to oracle.",
      "models": ["openai-codex/gpt-5.6-luna", "openai-codex/gpt-5.6-terra", "openai-codex/gpt-5.6-sol"]
    },
    "deep": {
      "description": "Legacy preset name for the mixed pool; workers retain economical candidate order, oracle uses strong models.",
      "models": ["zai/glm-5-turbo", "zai/glm-5.3-flash", "openai-codex/gpt-5.6-luna", "openai-codex/gpt-5.6-terra", "openai-codex/gpt-5.6-sol", "zai/glm-5.3"]
    }
  },
  // Override role behavior here or define project specialists in .pi/agents/.
  // Old builtin names are not aliases; define them explicitly only when you
  // intentionally want custom types with those exact names.
  // Per-type "icon" names the agent glyph for UI widgets (agent, search, code,
  // flask, globe, sparkles, brain, wrench, terminal, bug, book, eye, zap, rocket).
  "types": {}
}
